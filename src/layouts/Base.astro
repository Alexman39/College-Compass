---
/**
 * The HTML shell every page uses.
 *
 *   <Base title="Web Technologies" description="…">…</Base>
 *
 * `lang` defaults to "el" because most content is Greek. Wrap English
 * passages in <span lang="en"> (or pass lang="en" for an English page) so
 * screen readers switch pronunciation.
 */
import '@fontsource-variable/manrope';
import '~/styles/tokens.css';
import '~/styles/base.css';
import SkyScene from '~/components/SkyScene.astro';
import TopBar from '~/components/TopBar.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { url } from '~/lib/url';
import { validateContent } from '~/lib/content';

// Every page uses this layout, so this guarantees the cross-file content
// checks run on every build (once — the result is cached).
await validateContent();

interface Props {
  title?: string;
  description?: string;
  lang?: 'el' | 'en';
  /** Keep the page out of search engines (e.g. /styleguide). */
  noindex?: boolean;
  /**
   * Include this page in the site's own search (Pagefind). Only content
   * pages (courses, lessons) opt in, so results aren't cluttered with
   * the home page, calendars or the style guide.
   */
  searchable?: boolean;
}

const SITE = 'College Compass';
const {
  title,
  description = 'Ο ανεπίσημος οδηγός μαθημάτων του Metropolitan College: μαθήματα, εβδομάδες, εργασίες και προθεσμίες σε ένα μέρος.',
  lang = 'el',
  noindex = false,
  searchable = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE}` : SITE;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview card for shared links (Viber, Messenger, Discord, LinkedIn…).
// public/og-image.png; source in scripts/og-image.html.
const ogImage = new URL(url('og-image.png'), Astro.site);
const isHome = Astro.url.pathname === url();
// Tells search engines the site's name, so results show "College Compass"
// rather than the bare domain. Home page only, as Google asks.
const siteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE,
  alternateName: 'collegecompass.gr',
  url: new URL(url(), Astro.site).href,
  inLanguage: 'el',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Never block pinch-zoom: no maximum-scale / user-scalable here. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'el_GR'} />
    <meta property="og:title" content={title ?? SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="College Compass: Η πυξίδα σου για το πτυχίο" />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(siteData)} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#3d9be0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#03101b" media="(prefers-color-scheme: dark)" />

    <!-- Runs before paint to set the theme (and the lesson width) and avoid
         a flash of the wrong look. Must be inline (not bundled) to run that early. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('cc-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
        // Lesson text width (WidthToggle.astro); set early so the page
        // doesn't jump from narrow to wide after loading.
        var w = null;
        try { w = localStorage.getItem('cc-width'); } catch (e) {}
        if (w === 'wide') document.documentElement.dataset.width = 'wide';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a>
    <SkyScene />
    <TopBar />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  /* Hidden until focused with Tab — then it's the first thing you see. */
  .skip-link {
    position: absolute;
    top: var(--s-2);
    left: var(--s-2);
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-md);
    background: var(--panel-solid);
    color: var(--text);
    font-weight: 700;
    box-shadow: var(--shadow-md);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
