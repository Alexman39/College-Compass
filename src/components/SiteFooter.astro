---
/**
 * Small footer: the "unofficial" disclaimer and, once the visitor has ticked
 * anything, a quiet two-step "clear my ticks" control.
 */
import { url } from '~/lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="panel inner">
      <p>
        Φτιαγμένο από φοιτητές, για φοιτητές. Ανεπίσημος οδηγός — για τα επίσημα υλικά και τις υποβολές ισχύει
        πάντα το Moodle.
      </p>

      <!-- Shown by the script below only when there are ticks to clear. -->
      <div class="reset" data-reset hidden>
        <p class="muted">
          <span data-reset-count></span> Οι σημειώσεις σου μένουν μόνο σε αυτόν τον browser.
        </p>
        <button type="button" class="link-button" data-reset-ask>Διαγραφή των σημειώσεών μου</button>
        <span class="confirm" data-reset-confirm hidden>
          <span>Σίγουρα;</span>
          <button type="button" class="link-button danger" data-reset-yes>Ναι, διαγραφή</button>
          <button type="button" class="link-button" data-reset-no>Άκυρο</button>
        </span>
      </div>
      <p class="visually-hidden" role="status" data-reset-status></p>

      <p class="muted">
        © {year} College Compass · <a href={url('about')}>Σχετικά & ιδιωτικότητα</a>
      </p>
    </div>
  </div>
</footer>

<script>
  import { clearTicks, onTicksChange, readTicks } from '~/scripts/tick-store';

  const box = document.querySelector<HTMLElement>('[data-reset]')!;
  const count = box.querySelector<HTMLElement>('[data-reset-count]')!;
  const ask = box.querySelector<HTMLButtonElement>('[data-reset-ask]')!;
  const confirmBox = box.querySelector<HTMLElement>('[data-reset-confirm]')!;
  const yes = box.querySelector<HTMLButtonElement>('[data-reset-yes]')!;
  const no = box.querySelector<HTMLButtonElement>('[data-reset-no]')!;
  const status = document.querySelector<HTMLElement>('[data-reset-status]')!;

  const showAsk = () => {
    confirmBox.hidden = true;
    ask.hidden = false;
  };

  const update = () => {
    const n = readTicks().size;
    box.hidden = n === 0;
    count.textContent = n === 1 ? 'Έχεις σημειώσει 1 εργασία ως ολοκληρωμένη.' : `Έχεις σημειώσει ${n} εργασίες ως ολοκληρωμένες.`;
    if (n === 0) showAsk();
  };

  ask.addEventListener('click', () => {
    ask.hidden = true;
    confirmBox.hidden = false;
    no.focus();
  });
  no.addEventListener('click', () => {
    showAsk();
    ask.focus();
  });
  yes.addEventListener('click', () => {
    clearTicks();
    status.textContent = 'Οι σημειώσεις σου διαγράφηκαν.';
  });

  update();
  onTicksChange(update);
</script>

<style>
  .footer {
    margin-top: var(--s-8);
    padding-bottom: var(--s-5);
  }

  .inner {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    font-size: var(--fs-sm);
  }

  .muted {
    color: var(--text-muted);
  }

  .reset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
  }

  .reset[hidden],
  .confirm[hidden],
  .link-button[hidden] {
    display: none;
  }

  .confirm {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .link-button {
    min-height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .danger {
    color: var(--text-danger);
  }
</style>
