---
/**
 * Sticky top bar: compass orb + name (links home), the main navigation and
 * the theme toggle. In phase A5 the orb becomes the Start-menu button.
 */
import CompassOrb from './CompassOrb.astro';
import ThemeToggle from './ThemeToggle.astro';
import { url, isCurrent } from '~/lib/url';

const home = url();
const onHome = isCurrent(home, Astro.url.pathname);
const links = [
  { href: home, label: 'Αρχική' },
  { href: url('upcoming'), label: 'Προθεσμίες' },
  { href: url('calendar'), label: 'Ημερολόγιο' },
  { href: url('archive'), label: 'Αρχείο' },
].map((l) => ({ ...l, current: isCurrent(l.href, Astro.url.pathname) }));
---

<header class="topbar">
  <div class="container bar">
    <a class="brand" href={home} aria-current={onHome ? 'page' : undefined}>
      <CompassOrb size={40} />
      <span class="name">College Compass</span>
    </a>
    <nav class="nav" aria-label="Κύρια πλοήγηση">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--s-2);
    background: var(--glass);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: var(--highlight), var(--shadow-sm);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .topbar { background: var(--panel-solid); }
  }

  /* Phones: brand + toggle on one row, navigation underneath.
   * Wide screens: everything on one row. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand tools'
      'nav nav';
    align-items: center;
    gap: var(--s-1) var(--s-3);
  }

  .brand { grid-area: brand; justify-self: start; }
  .tools { grid-area: tools; }
  .nav { grid-area: nav; }

  @media (min-width: 52rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav tools';
    }
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .nav ul {
      justify-content: center;
      margin-inline: 0;
    }
    .nav a {
      padding: 0 var(--s-3);
    }
  }

  .nav ul {
    margin-inline: calc(var(--s-2) * -1); /* align text with the brand */
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-2);
    border-radius: var(--r-pill);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--glass-strong);
  }

  /* Current page: a solid jelly-style pill. */
  .nav a[aria-current='page'] {
    background: var(--panel-solid);
    box-shadow: var(--highlight), var(--shadow-sm);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding-right: var(--s-2);
    border-radius: var(--r-pill);
    color: var(--text);
    text-decoration: none;
  }

  .name {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
</style>
