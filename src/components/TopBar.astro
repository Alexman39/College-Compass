---
/**
 * Sticky top bar: compass orb + name (links home) and the theme toggle.
 * In phase A5 the orb becomes the Start-menu button and the main nav
 * (Προθεσμίες, Ημερολόγιο, Αρχείο…) lands here once those pages exist.
 */
import CompassOrb from './CompassOrb.astro';
import ThemeToggle from './ThemeToggle.astro';
import { url, isCurrent } from '~/lib/url';

const home = url();
const onHome = isCurrent(home, Astro.url.pathname);
---

<header class="topbar">
  <div class="container bar">
    <a class="brand" href={home} aria-current={onHome ? 'page' : undefined}>
      <CompassOrb size={40} />
      <span class="name">College Compass</span>
    </a>
    <div class="tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--s-2);
    background: var(--glass);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: var(--highlight), var(--shadow-sm);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .topbar { background: var(--panel-solid); }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding-right: var(--s-2);
    border-radius: var(--r-pill);
    color: var(--text);
    text-decoration: none;
  }

  .name {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
</style>
