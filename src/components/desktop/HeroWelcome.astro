---
/**
 * Hero direction B — "Welcome Center". Compact and practical, like the
 * Windows 7 Welcome Center: one window with the greeting, a one-line summary
 * of the week, and glossy quick-launch tiles. Gets out of the way so the
 * gadgets start sooner on a phone.
 */
import Window from '~/components/Window.astro';
import type { ForecastWeek } from '~/lib/derive';
import { url } from '~/lib/url';

interface Props {
  thisWeek: ForecastWeek | undefined;
  currentCourses: number;
}
const { thisWeek, currentCourses } = Astro.props;
const n = thisWeek?.count ?? 0;
const summary =
  currentCourses === 0
    ? 'Τα μαθήματα του νέου εξαμήνου προστίθενται σύντομα. Μέχρι τότε, όλο το αρχείο είναι εδώ.'
    : n === 0
      ? 'Καμία προθεσμία αυτή την εβδομάδα.'
      : `Αυτή την εβδομάδα: ${n === 1 ? '1 προθεσμία' : `${n} προθεσμίες`}.`;

const tiles = [
  { href: url('upcoming'), label: 'Προθεσμίες', hint: 'Τις επόμενες 14 ημέρες', icon: 'M12 7v5l3 2M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18z' },
  { href: url('calendar'), label: 'Ημερολόγιο', hint: 'Και στο κινητό σου', icon: 'M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM4 10h16M8 3v4M16 3v4' },
  { href: url('archive'), label: 'Αρχείο', hint: 'Έτος 1 και 2', icon: 'M3 4h18v4H3zM5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4' },
];
---

<div class="welcome">
<Window as="section" title="Η πυξίδα σου για το πτυχίο" level={1} accent="#1565a8">
  <div class="layout">
    <div class="text">
      <p class="hello"><span data-greeting>Καλώς ήρθες</span>!</p>
      <p class="today" data-today></p>
      <p class="summary">{summary}</p>
    </div>
    <ul class="tiles" role="list">
      {
        tiles.map((t) => (
          <li>
            <a href={t.href} class="tile">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={t.icon} />
                </svg>
              </span>
              <span class="label">{t.label}</span>
              <span class="hint">{t.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Window>
</div>

<script>
  import '~/scripts/greeting';
</script>

<style>
  .welcome {
    margin-top: var(--s-5);
  }

  .layout {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 52rem) {
    .layout {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .text {
    display: grid;
    gap: var(--s-1);
  }

  .hello {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .today {
    color: var(--text-muted);
    font-weight: 700;
  }

  .today:empty {
    display: none;
  }

  .summary {
    margin-top: var(--s-2);
    max-width: 38rem;
    font-size: var(--fs-lg);
  }

  /* Phones: a list of launchers (icon left, text right).
   * Wider: three square tiles side by side. */
  .tiles {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 52rem) {
    .tiles {
      grid-template-columns: repeat(3, 8.5rem);
    }
  }

  /* Glossy launcher tiles. */
  .tile {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--s-3);
    align-items: center;
    height: 100%;
    padding: var(--s-3) var(--s-2);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    background: linear-gradient(var(--panel-solid), var(--panel-sunken));
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--highlight), var(--shadow-sm);
    transition: transform var(--dur-med) var(--ease-overshoot), box-shadow var(--dur-med);
  }

  .tile:hover {
    color: var(--text);
    transform: translateY(-2px);
    box-shadow: var(--highlight), var(--shadow-md);
  }

  .icon {
    grid-row: span 2;
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #fff;
    background: radial-gradient(circle at 35% 25%, #6fd0ff, #1478c8 60%, #0a3f7a);
    box-shadow: inset 0 -2px 4px rgb(0 0 0 / 0.25), 0 2px 4px rgb(4 40 80 / 0.3);
  }

  .icon::before {
    content: '';
    position: absolute;
    inset: 3px 6px 50%;
    border-radius: 10px 10px 40% 40%;
    background: linear-gradient(rgb(255 255 255 / 0.6), rgb(255 255 255 / 0.05));
  }

  .icon svg {
    position: relative;
  }

  .label {
    align-self: end;
    font-weight: 800;
  }

  .hint {
    align-self: start;
  }

  @media (min-width: 36rem) {
    .tile {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: 2px;
      text-align: center;
    }
    .icon {
      grid-row: auto;
    }
    .label,
    .hint {
      align-self: auto;
    }
  }

  .hint {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
</style>
