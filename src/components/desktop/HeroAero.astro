---
/**
 * Hero direction A — "Aero horizon". Scenic: a big glossy orb and greeting
 * set straight onto the sky, a water horizon with a soft reflection, and the
 * next-deadline countdown as a large glass gadget beside it.
 *
 * Headline text sits on the sky itself (large text, ≥ 3:1 on the lightest
 * part of the gradient); the paragraph sits on a solid chip.
 */
import CompassOrb from '~/components/CompassOrb.astro';
import JellyButton from '~/components/JellyButton.astro';
import NextDeadline from './NextDeadline.astro';
import type { DeadlineItem } from '~/lib/derive';
import { url } from '~/lib/url';

interface Props {
  deadlines: DeadlineItem[];
  now: Date;
}
const { deadlines, now } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="intro">
    <CompassOrb size={84} />
    <p class="hello"><span data-greeting>Καλώς ήρθες</span><span class="sep" aria-hidden="true"> · </span><span data-today></span></p>
    <h1 id="hero-title">Η πυξίδα σου για το πτυχίο</h1>
    <p class="lead">
      Μαθήματα, εβδομάδες, εργασίες και προθεσμίες, σε ένα μέρος, πιο καθαρά από το <span lang="en">Moodle</span>.
    </p>
    <div class="actions">
      <JellyButton href={url('upcoming')}>Προθεσμίες</JellyButton>
      <JellyButton href={url('calendar')} variant="glass">Ημερολόγιο</JellyButton>
    </div>
  </div>
  <div class="side">
    <NextDeadline items={deadlines} now={now} />
  </div>
  <div class="horizon" aria-hidden="true"></div>
</section>

<script>
  import '~/scripts/greeting';
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--s-5);
    padding: var(--s-5) 0 var(--s-6);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
      padding: var(--s-7) 0 var(--s-8);
    }
  }

  .intro {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }

  .hello {
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    background: var(--panel-solid);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 2;
  }

  /* Before the script fills in the date, hide the separator. */
  .hello:has([data-today]:empty) .sep {
    display: none;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 1.6rem + 4.5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    /* A faint glow keeps the edges crisp over clouds. */
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.5), 0 0 24px rgb(255 255 255 / 0.35);
  }

  :global([data-theme='dark']) h1 {
    text-shadow: 0 0 28px rgb(80 200 255 / 0.35);
  }

  .lead {
    max-width: 34rem;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--panel-solid);
    box-shadow: var(--highlight), var(--shadow-sm);
    font-size: var(--fs-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .side {
    position: relative;
    z-index: 1;
  }

  /* Water horizon: a bright line with a soft aqua reflection below it. */
  .horizon {
    position: absolute;
    inset: auto calc(var(--gutter) * -1) 0;
    height: var(--s-6);
    border-top: 1px solid rgb(255 255 255 / 0.8);
    background: linear-gradient(rgb(127 224 230 / 0.45), transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }

  :global([data-theme='dark']) .horizon {
    border-top-color: rgb(140 230 255 / 0.4);
    background: linear-gradient(rgb(40 170 200 / 0.3), transparent);
  }
</style>
