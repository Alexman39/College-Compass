---
/**
 * Line icons for course tiles and window title bars. Decorative (the course
 * name is always written next to them), so hidden from screen readers.
 * The names match COURSE_ICONS in content.config.ts; add both together.
 */
import type { COURSE_ICONS } from '~/content.config';

interface Props {
  name: (typeof COURSE_ICONS)[number];
  size?: number;
}

const { name, size = 24 } = Astro.props;

// SVG path data on a 24×24 grid, drawn with a 2px stroke.
const PATHS: Record<Props['name'], string> = {
  code: 'M8 6l-6 6 6 6M16 6l6 6-6 6',
  brackets: 'M8 3H7a3 3 0 0 0-3 3v3a3 3 0 0 1-2 3 3 3 0 0 1 2 3v3a3 3 0 0 0 3 3h1M16 3h1a3 3 0 0 1 3 3v3a3 3 0 0 0 2 3 3 3 0 0 0-2 3v3a3 3 0 0 1-3 3h-1',
  sigma: 'M18 5H6l6 7-6 7h12',
  briefcase: 'M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18',
  diagram: 'M9 3h6v5H9zM3 16h6v5H3zM15 16h6v5h-6zM12 8v4M6 16v-4h12v4',
  chip: 'M8 7h8a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4',
  network: 'M12 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM5 17a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM19 17a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM12 7v5M12 12l-5.5 5.5M12 12l5.5 5.5',
  signal: 'M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h.01',
  globe: 'M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zM3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18',
  mobile: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2',
  database: 'M12 2c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  tree: 'M12 2.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM6 11a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM18 11a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 19a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM9 19a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM11 6.3l-3.6 5M13 6.3l3.6 5M5.3 14.8 3.8 19.2M6.7 14.8l1.5 4.4',
  book: 'M3 5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v16a2 2 0 0 0-2-2H3zM21 5a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v16a2 2 0 0 1 2-2h7z',
};
---

<svg
  class="course-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={PATHS[name]}></path>
</svg>
