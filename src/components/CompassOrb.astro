---
/**
 * The glossy compass orb — the site's logo and (from phase A5) the button
 * that opens the Start-menu panel. This component is only the *visual*;
 * the wrapping <a>/<button> supplies the accessible name.
 */
interface Props {
  size?: number; // px
}
const { size = 44 } = Astro.props;
---

<span class="orb" style={`--orb:${size}px`}>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <!-- Compass needle: north half red, south half white -->
    <path d="M16 5 L20 16 L16 16 Z" fill="#ff5a4e" />
    <path d="M16 5 L12 16 L16 16 Z" fill="#d93a32" />
    <path d="M16 27 L12 16 L16 16 Z" fill="#ffffff" />
    <path d="M16 27 L20 16 L16 16 Z" fill="#d6e6f0" />
    <circle cx="16" cy="16" r="1.8" fill="#0c2636" />
  </svg>
</span>

<style>
  .orb {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--orb);
    aspect-ratio: 1;
    border-radius: 50%;
    /* Sphere: light from top-left, deep aqua core, bright rim at the bottom
     * (the "glow from within" that defines the Vista/7 start orb). */
    background:
      radial-gradient(circle at 50% 120%, rgb(140 255 230 / 0.9), transparent 55%),
      radial-gradient(circle at 35% 30%, #5fd0ff, #1478c8 55%, #0a3f7a 100%);
    box-shadow:
      inset 0 -2px 6px rgb(0 0 0 / 0.25),
      inset 0 0 0 1px rgb(255 255 255 / 0.35),
      0 2px 6px rgb(4 40 80 / 0.35);
    transition: transform var(--dur-med) var(--ease-overshoot), filter var(--dur-fast);
  }

  /* The glass highlight: an ellipse across the top half. */
  .orb::before {
    content: '';
    position: absolute;
    inset: 5% 14% 50%;
    border-radius: 50% 50% 45% 45%;
    background: linear-gradient(rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.05));
  }

  svg {
    position: relative;
    width: 66%;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.35));
  }

  /* Hover/focus react on whatever interactive element wraps the orb. */
  :global(:is(a, button):hover) > .orb,
  :global(:is(a, button):focus-visible) > .orb {
    transform: scale(1.06);
    filter: brightness(1.08) saturate(1.1);
  }
</style>
