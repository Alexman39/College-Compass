---
/**
 * Design preview — hero direction A · Aero horizon, on the full desktop layout with
 * sample data. Temporary: removed once a direction is chosen.
 */
import Base from '~/layouts/Base.astro';
import Desktop from '~/components/desktop/Desktop.astro';
import PreviewBanner from '~/components/desktop/PreviewBanner.astro';
import HeroAero from '~/components/desktop/HeroAero.astro';
import { url } from '~/lib/url';
import { sampleDesktop } from './_sample';

const now = new Date();
const d = await sampleDesktop(now);
---

<Base title="Προεπισκόπηση: A · Aero horizon" noindex>
  <div class="container">
    <PreviewBanner name="A · Aero horizon" other={{ href: url('preview/hero-b'), label: 'Δες την κατεύθυνση B' }} />
    <Desktop now={now} {...d} nextInHero>
      <HeroAero slot="hero" deadlines={d.deadlines} now={now} />
    </Desktop>
  </div>
</Base>
