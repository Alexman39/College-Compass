---
/**
 * Design preview — hero direction B · Welcome Center, on the full desktop layout with
 * sample data. Temporary: removed once a direction is chosen.
 */
import Base from '~/layouts/Base.astro';
import Desktop from '~/components/desktop/Desktop.astro';
import PreviewBanner from '~/components/desktop/PreviewBanner.astro';
import HeroWelcome from '~/components/desktop/HeroWelcome.astro';
import { url } from '~/lib/url';
import { sampleDesktop } from './_sample';

const now = new Date();
const d = await sampleDesktop(now);
---

<Base title="Προεπισκόπηση: B · Welcome Center" noindex>
  <div class="container">
    <PreviewBanner name="B · Welcome Center" other={{ href: url('preview/hero-a'), label: 'Δες την κατεύθυνση A' }} />
    <Desktop now={now} {...d} >
      <HeroWelcome slot="hero" thisWeek={d.forecast[0]} currentCourses={3} />
    </Desktop>
  </div>
</Base>
